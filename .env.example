# 数据库文件（相对仓库根目录）。第一次运行会自动建表。
HORON_DB=horon.db
# 可选：语义检索、suggest_name、audit 用的模型都走 OpenRouter（只走零数据留存端点）。不填也能用，只是这几个命令不可用、书腰不生成向量。
OPENROUTER_API_KEY=
# 可选：suggest_name 起名优先走 OpenCode Go。不填就用上面的 OPENROUTER_API_KEY 走 OpenRouter。Go 不受零留存限制。
OPENCODE_GO_API_KEY=
# 可选：一份短说明书的文件路径。读者打不开这台机器的文件时（比如远程服务）设上：login 输出末尾放它的全文，不再打本仓库 SKILL.md 的路径。
HORON_MANUAL_FILE=
# 可选：远程模式。填 aisoulkeeper 的 API key 就用线上的记忆库：CLI 命令发给服务器执行，钩子读 .horon-local/remote/ 下单独的规则库（服务器规则一变就同步过来），HORON_DB 不读也不写。
HORON_REMOTE_KEY=
