# 数据库文件（相对仓库根目录）。第一次运行会自动建表。
HORON_DB=horon.db
# 可选：search_semantic 语义检索用的 embedding（OpenRouter）。不填也能用，只是 search_semantic 不可用、书腰不生成向量。
OPENROUTER_API_KEY=
# 可选：suggest_name 起名小助手优先走 OpenCode Go。不填就用上面的 OPENROUTER_API_KEY 走 OpenRouter。
OPENCODE_GO_API_KEY=
# 可选：远程 HTTP 接口 POST /v1/cli 的唯一 API key（请求头 X-API-Key: <key> 或 Authorization: Bearer <key>）。
# 不填或留空 = 远程接口整体关闭（一律返回 503）。用只含 ASCII 字符的长随机串，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HORON_API_KEY=
