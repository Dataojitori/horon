# 数据库文件（相对仓库根目录）。第一次运行会自动建表。
HORON_DB=horon.db
# 可选：search_semantic 语义检索用的 embedding（OpenRouter）。不填也能用，只是 search_semantic 不可用、书腰不生成向量。
OPENROUTER_API_KEY=
# 可选：suggest_name 起名小助手优先走 OpenCode Go。不填就用上面的 OPENROUTER_API_KEY 走 OpenRouter。
OPENCODE_GO_API_KEY=
# 可选：login 输出里的说明书地址。读者打不开这台机器的文件时（比如远程服务）设成读者能打开的网址；不填就显示本仓库 SKILL.md 的路径。
HORON_MANUAL_LOCATION=
# 可选：一份短说明书的文件路径。设了就把全文放在 login 输出末尾，不再打上面的地址。
HORON_MANUAL_FILE=
